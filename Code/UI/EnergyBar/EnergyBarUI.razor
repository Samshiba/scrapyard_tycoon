@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<root>
    @{
        float energy = ActiveWeapon?.GetEnergyPercentage() ?? 1f;
        bool show = ActiveWeapon?.ShouldShowEnergyBar() ?? false;
        bool exhausted = ActiveWeapon?.IsExhausted ?? false;
    }

    <div class="energy-container @(show ? "" : "hidden") @(exhausted ? "exhausted" : "")">
        <div class="energy-track">
            <div class="energy-fill" style="width: @(energy * 100)%;"></div>
        </div>
    </div>
</root>

@code {
    public static EnergyBarUI Local { get; private set; }

    PlayerInventory Inventory;
    BaseWeapon ActiveWeapon => Inventory?.ActiveWeapon as BaseWeapon;

    protected override void OnAwake()
    {
        Local = this;
    }

    protected override void OnStart()
    {
        TryFindInventory();
    }

    protected override void OnUpdate()
    {
        if (Inventory == null)
        {
            TryFindInventory();
        }
    }

    void TryFindInventory()
    {
        Inventory = Scene.GetAllComponents<PlayerInventory>().FirstOrDefault(x => !x.IsProxy);
    }

    protected override int BuildHash()
    {
        if (ActiveWeapon is null) return 0;
        return HashCode.Combine(ActiveWeapon.GetEnergyPercentage(), ActiveWeapon.ShouldShowEnergyBar(),
ActiveWeapon.IsExhausted);
    }
}