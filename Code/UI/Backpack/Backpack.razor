@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@using System.Linq

<root>
	<div class="backpack-panel">

		<!-- Argent -->
		<div class="stat-row money-row">
			<label class="stat-icon">⬡</label>
			<label class="stat-value money-value">@((int)Stats?.TotalScrap) SC</label>
		</div>

		<div class="separator"></div>

		<!-- Gibs -->
		<div class="stat-row">
			<label class="stat-icon">📦</label>
			<div class="gibs-block">
				<div class="gibs-bar-track">
					<div class="gibs-bar-fill" style="width: @(FillPercent)%; background-color: @FillColor;"></div>
				</div>
				<label class="gibs-label" style="color: @FillColor;">
					@(playerBackpack?.CurrentItemCount) / @(playerBackpack?.MaxItems)
				</label>
			</div>
		</div>

	</div>
</root>

@code {
	PlayerBackpack playerBackpack;
	PlayerStats Stats;

	float FillPercent => playerBackpack == null || playerBackpack.MaxItems == 0
		? 0
		: ((float)playerBackpack.CurrentItemCount / playerBackpack.MaxItems) * 100f;

	// Vert → Jaune → Rouge selon remplissage
	string FillColor
	{
		get
		{
			var pct = FillPercent;
			if (pct < 50f) return "#6ecf81"; // vert
			if (pct < 80f) return "#f0c040"; // jaune
			return "#e8503a"; // rouge
		}
	}

	protected override void OnStart()
	{
		Grab();
	}

	protected override void OnUpdate()
	{
		if (playerBackpack == null || Stats == null) Grab();
	}

	void Grab()
	{
		var player = Scene.GetAllComponents<PlayerController>().FirstOrDefault(x => !x.IsProxy);
		if (player == null) return;
		playerBackpack = player.Components.Get<PlayerBackpack>();
		Stats = player.Components.Get<PlayerStats>();
	}

	protected override int BuildHash() =>
		System.HashCode.Combine(
		playerBackpack?.CurrentItemCount,
		playerBackpack?.MaxItems,
			(int)(Stats?.TotalScrap ?? 0)
		);
}