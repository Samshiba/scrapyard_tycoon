@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Utils;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="backpack-panel">

		<!-- Argent -->
		<div class="stat-row money-row">
			<label class="stat-icon">⬡</label>
			<label class="stat-value money-value">@NumberFormatter.FormatWithSuffix(GetScrap()) SC</label>
		</div>

		<div class="separator"></div>

		<!-- Gibs -->
		<div class="stat-row">
			<label class="stat-icon">📦</label>
			<div class="gibs-block">
				<div class="gibs-bar-track">
					<div class="gibs-bar-fill" style="width: @(FillPercent)%; background-color: @FillColor;"></div>
				</div>
				<label class="gibs-label" style="color: @FillColor;">
					@(GetLocalBackpack()?.CurrentItemCount) / @(GetLocalBackpack()?.MaxItems)
				</label>
			</div>
		</div>

	</div>
</root>

@code {
	PlayerBackpack GetLocalBackpack()
	{
		return Scene.GetAllComponents<PlayerBackpack>().FirstOrDefault(x => !x.IsProxy);
	}

	float FillPercent => GetLocalBackpack() == null || GetLocalBackpack().MaxItems == 0
		? 0
		: ((float)GetLocalBackpack().CurrentItemCount / GetLocalBackpack().MaxItems) * 100f;

	// Vert → Jaune → Rouge selon remplissage
	string FillColor
	{
		get
		{
			var pct = FillPercent;
			if (pct < 50f) return "#6ecf81"; // vert
			if (pct < 80f) return "#f0c040"; // jaune
			return "#e8503a"; // rouge
		}
	}

	double GetScrap() => FactoryStats.Get(Scene)?.TotalScrap ?? 0;

	protected override int BuildHash()
	{
		var h = new System.HashCode();
		h.Add(GetScrap());
		h.Add(GetLocalBackpack()?.CurrentItemCount);
		h.Add(GetLocalBackpack()?.MaxItems);

		return h.ToHashCode();
	}
}