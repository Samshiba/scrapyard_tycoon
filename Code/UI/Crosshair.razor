@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
	<div class="dot"></div>
</root>

<style>
	root {
		width: 100%;
		height: 100%;
	}

	.dot {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 8px;
		height: 8px;
		background-color: rgba(255, 255, 255, 0.5);
		border-radius: 50%;
	}
</style>