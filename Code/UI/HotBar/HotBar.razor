@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@using System.Linq

<root>
	<div class="hotbar">
		@for (int i = 0; i < 4; i++)
		{
			var index = i;
			var weapon = PlayerInventory.Local?.EquippedWeapons.Length > index
				? PlayerInventory.Local.EquippedWeapons[index]
				: null;
			var isActive = PlayerInventory.Local?.ActiveSlotIndex == index && ActiveWeaponObject != null;

			<div class="hotbar-slot @(isActive ? "active" : "") @(weapon == null ? "empty" : "")">
				<span class="slot-number">@(index + 1)</span>

				@if (weapon != null)
				{
					@if (!string.IsNullOrEmpty(weapon.IconPath))
					{
						<img src="@weapon.IconPath" class="slot-icon" />
					}
					else
					{
						<span class="slot-name">@weapon.LocalizationKeyName</span>
					}
				}
			</div>
		}
	</div>
</root>

@code {
	GameObject ActiveWeaponObject => PlayerInventory.Local?.ActiveWeapon?.GameObject;

	protected override void OnUpdate()
	{
		StateHasChanged();
	}

	protected override int BuildHash()
	{
		return System.HashCode.Combine(
			PlayerInventory.Local?.ActiveSlotIndex,
			PlayerInventory.Local?.ActiveWeapon,
			PlayerInventory.Local?.EquippedWeapons != null ? string.Join(",", PlayerInventory.Local.EquippedWeapons.Select(w =>
w?.Id ?? "null")) : "null"
		);
	}
}