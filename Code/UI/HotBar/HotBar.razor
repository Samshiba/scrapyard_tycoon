@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@using System.Linq

<root>
	<div class="hotbar">
		@for (int i = 0; i < 4; i++)
		{
			var index = i;
			var weapon = GetLocalInventory()?.EquippedWeapons.Length > index
				? GetLocalInventory().EquippedWeapons[index]
				: null;
			var isActive = GetLocalInventory()?.ActiveSlotIndex == index && ActiveWeaponObject != null;

			<div class="hotbar-slot @(isActive ? "active" : "") @(weapon == null ? "empty" : "")">
				<span class="slot-number">@(index + 1)</span>

				@if (weapon != null)
				{
					@if (!string.IsNullOrEmpty(weapon.IconPath))
					{
						<img src="@weapon.IconPath" class="slot-icon" />
					}
					else
					{
						<span class="slot-name">@weapon.LocalizationKeyName</span>
					}
				}
			</div>
		}
	</div>
</root>

@code {
	GameObject ActiveWeaponObject => GetLocalInventory()?.ActiveWeapon?.GameObject;

	PlayerInventory GetLocalInventory()
	{
		return Scene.GetAllComponents<PlayerInventory>().FirstOrDefault(x => !x.IsProxy);
	}

	protected override void OnUpdate()
	{
		StateHasChanged();
	}

	protected override int BuildHash()
	{
		return System.HashCode.Combine(
			GetLocalInventory()?.ActiveSlotIndex,
			GetLocalInventory()?.ActiveWeapon,
			GetLocalInventory()?.EquippedWeapons != null ? string.Join(",", GetLocalInventory()?.EquippedWeapons.Select(w =>
w?.Id ?? "null")) : "null"
		);
	}
}